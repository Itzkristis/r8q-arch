# WiFi bring-up debug fragment (QCA6390 / ath11k / MHI).
#
# Not needed for a working system -- these only add logging while the
# PBL->SBL firmware handoff is being debugged. The WiFi stack itself needs
# NO config changes: ATH11K(+PCI), MHI, QRTR, PCIE_QCOM, PCI_PWRCTRL_PWRSEQ
# and POWER_SEQUENCING_QCOM_WCN are all already in arm64 defconfig.
#
# ATH11K_DEBUG turned out to be useless for this failure (the stall is below
# ath11k, in MHI). MHI_BUS_DEBUG is the useful one: it adds
# /sys/kernel/debug/mhi/<dev>/{states,regdump,events,channels,devices},
# and regdump exposes BHI_EXECENV / BHI_STATUS / BHI_ERRCODE / BHI_ERRDBG1-3
# -- i.e. PBL's own error code for why it won't run the downloaded image.
CONFIG_ATH11K_DEBUG=y
CONFIG_MHI_BUS_DEBUG=y
