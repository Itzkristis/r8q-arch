# r8q: system-wide PowerDevil profiles. Every profile deliberately OMITS the
# [*][SuspendSession] group — suspend/s2idle hard-resets the SM8250 (this was the
# "spontaneous reboot" cause; see LAB-NOTEBOOK). Screen blanking is kept but pushed out
# to 30 min and never locks, because there is no hardware keyboard to unlock with.
[AC]
icon=battery-charging

[AC][DPMSControl]
idleTime=1800
lockBeforeTurnOff=0

[AC][DimDisplay]
idleTime=900

[Battery]
icon=battery-060

[Battery][DPMSControl]
idleTime=1800
lockBeforeTurnOff=0

[Battery][DimDisplay]
idleTime=900

[LowBattery]
icon=battery-low

[LowBattery][DPMSControl]
idleTime=1800
lockBeforeTurnOff=0

[LowBattery][DimDisplay]
idleTime=900
