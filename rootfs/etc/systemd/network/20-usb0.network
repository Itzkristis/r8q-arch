[Match]
Name=usb0

[Network]
Address=172.16.42.1/24
DNS=1.1.1.1

# The USB tether stays as the fallback route: metric 1000, so an associated
# WiFi link (NetworkManager gives wifi a default metric of 600) wins for
# internet traffic. The on-link 172.16.42.0/24 route from Address= is
# unaffected, so SSH from the host keeps working regardless.
#
# NetworkManager must NOT manage this interface -- see
# /etc/NetworkManager/conf.d/10-r8q.conf.
[Route]
Gateway=172.16.42.14
Metric=1000
